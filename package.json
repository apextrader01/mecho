{
  "name": "short-edge-hyperlocal-superapp",
  "version": "1.0.0",
  "description": "Hyperlocal Indian Super-App (All-in-One Local Services Marketplace)",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "vendor",
    "admin"
  ],
  "scripts": {
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server start",
    "client:dev": "npm --prefix client run dev",
    "vendor:dev": "npm --prefix vendor run dev",
    "admin:dev": "npm --prefix admin run dev",
    "db:generate": "npm --prefix server run prisma:generate",
    "db:push": "npm --prefix server run prisma:push",
    "db:seed": "npm --prefix server run prisma:seed",
    "db:studio": "npm --prefix server run prisma:studio"
  },
  "keywords": [
    "hyperlocal",
    "india",
    "superapp",
    "emergency-fuel",
    "roadside-assistance",
    "quotations",
    "subscriptions"
  ],
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  },
  "author": "Senior Full-Stack Architect",
  "license": "MIT"
}
