PORT=5000
NODE_ENV=production

# Database: SQLite for local dev, PostgreSQL for staging/production
DATABASE_URL="postgresql://shortedge_user:YOUR_POSTGRES_PASSWORD@localhost:5432/shortedge_db?schema=public"

# JWT Authentication
JWT_SECRET="generate_a_cryptographically_secure_jwt_secret_key"
JWT_EXPIRES_IN="7d"

# Modular WhatsApp Service Hook (Meta Cloud API / Twilio)
WHATSAPP_ENABLED=true
WHATSAPP_API_URL="https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages"
WHATSAPP_API_TOKEN="YOUR_META_WHATSAPP_CLOUD_API_TOKEN"

# Server Base URL for uploaded fuel pump receipts, photos & KYC docs
SERVER_BASE_URL="https://api.shortedge.in"
CLIENT_ORIGIN="https://app.shortedge.in"
VENDOR_ORIGIN="https://partner.shortedge.in"
ADMIN_ORIGIN="https://admin.shortedge.in"
